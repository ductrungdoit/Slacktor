{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/extension/src/popup/*"],
      "@slacktor/ui": ["./packages/ui/src/index.ts"],
      "@slacktor/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [
    "apps/extension/src",
    "apps/extension/vite.config.ts",
    "apps/site/src",
    "apps/site/vite.config.ts",
    "packages/ui/src",
    "scripts"
  ]
}
