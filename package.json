{
  "name": "slacktor",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "release": "npm run icons && npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/chrome": "^0.0.307",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
